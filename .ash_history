cat > ping_vless.sh << 'EOF'
#!/bin/bash
# ping_vless.sh — Пингует все IP-адреса из VLESS-ключей
INPUT_FILE="${1:-текст.txt}"
TIMEOUT="${2:-2}"  # Таймаут пинга в секундах (по умолчанию 2)
if [[ ! -f "$INPUT_FILE" ]]; then
    echo "❌ Файл '$INPUT_FILE' не найден"
    exit 1
fi
echo "🔍 Извлекаю уникальные IP-адреса..."
# Извлекаем IP после @ и до : или /
grep -oE '@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+[:/]' "$INPUT_FILE" | \
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | \
    sort -u > /tmp/vless_ping_ips.txt
TOTAL=$(wc -l < /tmp/vless_ping_ips.txt)
echo "✅ Найдено уникальных IP: $TOTAL"
echo ""
echo "📡 Пингую с таймаутом ${TIMEOUT}с..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
printf "%-18s | %-8s | %-10s | %s\n" "IP-АДРЕС" "СТАТУС" "ВРЕМЯ" "ИНФО"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
ONLINE=0
OFFLINE=0
while IFS= read -r ip; do
    # Пинг: 1 пакет, таймаут, без вывода лишних данных
    result=$(ping -c 1 -W "$TIMEOUT" "$ip" 2>&1)
    
    if echo "$result" | grep -q "time="; then
        # Успешный ответ — извлекаем время
        time_ms=$(echo "$result" | grep -oP 'time=\K[0-9.]+' | head -1)
        printf "%-18s | \033[32m%-8s\033[0m | %-10s | OK\n" "$ip" "ONLINE" "${time_ms}ms"
        ((ONLINE++))
    elif echo "$result" | grep -q "Destination Host Unreachable\|Network is unreachable"; then
        printf "%-18s | \033[33m%-8s\033[0m | %-10s | No route\n" "$ip" "UNREACH" "-"
        ((OFFLINE++))
    else
        printf "%-18s | \033[31m%-8s\033[0m | %-10s | Timeout\n" "$ip" "OFFLINE" "-"
        ((OFFLINE++))
    fi
done < /tmp/vless_ping_ips.txt
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "📊 Итоги: \033[32m$ONLINE онлайн\033[0m / \033[31m$OFFLINE оффлайн\033[0m из $TOTAL"
# Сохраняем рабочие адреса в отдельный файл
echo ""
echo "💡 Рабочие IP сохранены в: working_ips.txt"
grep -B1 "ONLINE" <<< "$(ping -c 1 -W "$TIMEOUT" $(cat /tmp/vless_ping_ips.txt) 2>&1)" | \
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort -u > working_ips.txt 2>/dev/null || true
# Очистка
rm -f /tmp/vless_ping_ips.txt
EOF
cat > ping_vless.sh << 'EOF'
#!/bin/bash
# ping_vless.sh — Пингует все IP-адреса из VLESS-ключей
INPUT_FILE="${1:-текст.txt}"
TIMEOUT="${2:-2}"  # Таймаут пинга в секундах (по умолчанию 2)
if [[ ! -f "$INPUT_FILE" ]]; then
    echo "❌ Файл '$INPUT_FILE' не найден"
    exit 1
fi
echo "🔍 Извлекаю уникальные IP-адреса..."
# Извлекаем IP после @ и до : или /
grep -oE '@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+[:/]' "$INPUT_FILE" | \
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | \
    sort -u > /tmp/vless_ping_ips.txt
TOTAL=$(wc -l < /tmp/vless_ping_ips.txt)
echo "✅ Найдено уникальных IP: $TOTAL"
echo ""
echo "📡 Пингую с таймаутом ${TIMEOUT}с..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
printf "%-18s | %-8s | %-10s | %s\n" "IP-АДРЕС" "СТАТУС" "ВРЕМЯ" "ИНФО"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
ONLINE=0
OFFLINE=0
while IFS= read -r ip; do
    # Пинг: 1 пакет, таймаут, без вывода лишних данных
    result=$(ping -c 1 -W "$TIMEOUT" "$ip" 2>&1)
    
    if echo "$result" | grep -q "time="; then
        # Успешный ответ — извлекаем время
        time_ms=$(echo "$result" | grep -oP 'time=\K[0-9.]+' | head -1)
        printf "%-18s | \033[32m%-8s\033[0m | %-10s | OK\n" "$ip" "ONLINE" "${time_ms}ms"
        ((ONLINE++))
    elif echo "$result" | grep -q "Destination Host Unreachable\|Network is unreachable"; then
        printf "%-18s | \033[33m%-8s\033[0m | %-10s | No route\n" "$ip" "UNREACH" "-"
        ((OFFLINE++))
    else
        printf "%-18s | \033[31m%-8s\033[0m | %-10s | Timeout\n" "$ip" "OFFLINE" "-"
        ((OFFLINE++))
    fi
done < /tmp/vless_ping_ips.txt
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "📊 Итоги: \033[32m$ONLINE онлайн\033[0m / \033[31m$OFFLINE оффлайн\033[0m из $TOTAL"
# Сохраняем рабочие адреса в отдельный файл
echo ""
echo "💡 Рабочие IP сохранены в: working_ips.txt"
grep -B1 "ONLINE" <<< "$(ping -c 1 -W "$TIMEOUT" $(cat /tmp/vless_ping_ips.txt) 2>&1)" | \
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort -u > working_ips.txt 2>/dev/null || true
# Очистка
rm -f /tmp/vless_ping_ips.txt
EOF
