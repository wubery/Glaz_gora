#!/bin/bash
# vless_scan_fixed.sh — Исправленный парсинг Whois + Выровненный отчет
INPUT_FILE="${1:-текст.txt}"
OUTPUT_CSV="ip_whois_results.csv"
TMP_DIR=$(mktemp -d)
trap "rm -rf $TMP_DIR" EXIT
# Проверка утилит
for cmd in grep ping whois awk sort cut; do
  command -v $cmd &>/dev/null || { echo "❌ Установите пакет с командой: $cmd"; exit 1; }
done
[[ ! -f "$INPUT_FILE" ]] && { echo "❌ Файл '$INPUT_FILE' не найден"; exit 1; }
# ═══════════════════════════════════════════════════════
echo "🔐 ШАГ 1: Включите VPN для доступа к файлу с ключами"
echo "══════════════════════════════════════════════════════"
read -p "   ✅ VPN включён? Нажмите Enter для продолжения... "
echo "🔍 Извлекаю уникальные IP-адреса..."
# Ищем паттерн @IP: или @IP/
grep -oE '@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+[:/]' "$INPUT_FILE" | \
    cut -d'@' -f2 | sed 's/[:/]$//' | sort -u > "$TMP_DIR/all_ips.txt"
TOTAL=$(wc -l < "$TMP_DIR/all_ips.txt")
echo "   📦 Найдено уникальных IP: $TOTAL"
# ═══════════════════════════════════════════════════════
echo ""
echo "🔓 ШАГ 2: Выключите VPN для точного пинга"
echo "══════════════════════════════════════════════════════"
read -p "   ✅ VPN выключен? Нажмите Enter для продолжения... "
echo "📡 Пингую хосты (таймаут 2с)..."
> "$TMP_DIR/reachable.txt"
COUNT=0
while IFS= read -r ip; do
  COUNT=$((COUNT + 1))
  printf "\r   ⏳ [%3d/%3d] %-15s" "$COUNT" "$TOTAL" "$ip"
  if ping -c 1 -W 2 "$ip" &>/dev/null; then
    echo "$ip" >> "$TMP_DIR/reachable.txt"
  fi
done < "$TMP_DIR/all_ips.txt"
echo ""
REACH=$(wc -l < "$TMP_DIR/reachable.txt")
echo "   ✅ Доступных хостов: $REACH из $TOTAL"
[[ "$REACH" -eq 0 ]] && { echo "⚠️ Ни один IP не ответил. Завершаю."; exit 0; }
# ═══════════════════════════════════════════════════════
echo ""
echo "🔐 ШАГ 3: Включите VPN для whois-запросов"
echo "══════════════════════════════════════════════════════"
read -p "   ✅ VPN включён? Нажмите Enter для запуска whois... "
echo "IP;ORG;COUNTRY;ASN;SUBNET" > "$OUTPUT_CSV"
COUNT=0
while IFS= read -r ip; do
  COUNT=$((COUNT + 1))
  printf "\r   ⏳ [%3d/%3d] %s" "$COUNT" "$REACH" "$ip"
  
  # Увеличиваем таймаут до 10 секунд для стабильности через VPN
  # whois -H убирает лишний юридический текст
  RAW=$(timeout 10 whois -H "$ip" 2>/dev/null | tr -d '\r')
  if [[ -z "$RAW" ]]; then
    echo "$ip;Timeout;-;-;${ip%.*}.0/24" >> "$OUTPUT_CSV"
    continue
  fi
  # === Умный парсинг ===
  
  # 1. Ищем название организации
  ORG=$(echo "$RAW" | grep -iE '^(org-name|organisation|orgname):' | head -1 | sed 's/^[^:]*:[[:space:]]*//' | tr -d '\n')
  
  # Если нашли "RIPE Network" или пусто — пробуем взять NetName или Descr
  if [[ -z "$ORG" ]] || echo "$ORG" | grep -qi "RIPE Network"; then
    NETNAME=$(echo "$RAW" | grep -iE '^netname:' | head -1 | sed 's/^[^:]*:[[:space:]]*//' | tr -d '\n')
ls
