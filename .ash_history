#!/bin/bash
# ping_scan.sh - проверка пинга по подсети 79.174.0.0/24
SUBNET="79.174.0"
TIMEOUT=1  # секунда
COUNT=2    # количество пингов
echo "Начинаю проверку пинга для подсети $SUBNET.0/24"
echo "================================================"
for i in {1..254}; do
    IP="$SUBNET.$i"
    
    # Пинг с таймаутом
    if ping -c $COUNT -W $TIMEOUT $IP > /dev/null 2>&1; then
        # Получаем среднее время
        AVG_PING=$(ping -c 2 -W 1 $IP | tail -1 | awk -F '/' '{print $5}' | cut -d '.' -f 1)
        echo "✅ $IP доступен, пинг: ${AVG_PING:-?}мс"
    else
        echo "❌ $IP недоступен"
    fi
done
for i in {1..254}; do ip="79.174.0.$i"; ping -c1 -W1 $ip &>/dev/null && echo "✅ $ip"; done
cat > ping_scan.sh << 'EOF'
