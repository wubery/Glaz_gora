#!/bin/sh
# ping_vless.sh — Alpine-compatible ping script
INPUT_FILE="${1:-текст.txt}"
TIMEOUT="${2:-2}"
if [ ! -f "$INPUT_FILE" ]; then
    echo "❌ Файл '$INPUT_FILE' не найден"
    exit 1
fi
echo "🔍 Извлекаю уникальные IP-адреса..."
grep -oE '@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+[:/]' "$INPUT_FILE" | \
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | \
    sort -u > /tmp/vless_ips.txt
TOTAL=$(wc -l < /tmp/vless_ips.txt | tr -d ' ')
echo "✅ Найдено уникальных IP: $TOTAL"
echo ""
echo "📡 Пингую с таймаутом ${TIMEOUT}с..."
printf "%-18s | %-8s | %-10s | %s\n" "IP-АДРЕС" "СТАТУС" "ВРЕМЯ" "ИНФО"
printf "%s\n" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
ONLINE=0
OFFLINE=0
while read -r ip; do
    # Alpine ping: -c 1 пакет, -W таймаут в секундах
    result=$(ping -c 1 -W "$TIMEOUT" "$ip" 2>&1)
    
    if echo "$result" | grep -q "time="; then
        time_ms=$(echo "$result" | grep -oE 'time=[0-9.]+' | cut -d= -f2)
        printf "%-18s | \033[32m%-8s\033[0m | %-10s | OK\n" "$ip" "ONLINE" "${time_ms}ms"
        ONLINE=$((ONLINE + 1))
    elif echo "$result" | grep -qi "unreachable\|network is unreachable"; then
        printf "%-18s | \033[33m%-8s\033[0m | %-10s | No route\n" "$ip" "UNREACH" "-"
        OFFLINE=$((OFFLINE + 1))
    else
        printf "%-18s | \033[31m%-8s\033[0m | %-10s | Timeout\n" "$ip" "OFFLINE" "-"
        OFFLINE=$((OFFLINE + 1))
    fi
done < /tmp/vless_ips.txt
printf "%s\n" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "📊 Итоги: $ONLINE онлайн / $OFFLINE оффлайн из $TOTAL"
# Сохраняем рабочие адреса
grep -B1 "ONLINE" <<< "$(ping -c 1 -W "$TIMEOUT" $(cat /tmp/vless_ips.txt) 2>&1)" | \
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort -u > working_ips.txt 2>/dev/null || true
echo "💡 Рабочие IP сохранены в: working_ips.txt"
rm -f /tmp/vless_ips.txt
EOF
