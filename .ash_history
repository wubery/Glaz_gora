# 3. Проверьте, есть ли коммиты
git log --oneline -1 2>/dev/null || echo "❌ Нет коммитов"
# 4. Если нет коммитов — сделайте первый коммит
git add auto_scan.sh README.md
git commit -m "🔍 Initial commit: VLESS IP scanner"
# 5. Проверьте имя текущей ветки
git branch --show-current
# 6. Если ветка называется master — переименуйте в main (или используйте master при пуше)
git branch -M main
# 7. Теперь пуш
git push -u origin main
# Удалить старый remote и добавить правильный
git remote remove origin
