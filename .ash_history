#!/bin/sh
# ping_whois.sh — Пинг + Whois для VLESS адресов
INPUT_FILE="${1:-текст.txt}"
OUTPUT_FILE="subnet_owners.csv"
PING_RESULT="ping_results.txt"
if [ ! -f "$INPUT_FILE" ]; then
    echo "❌ Файл '$INPUT_FILE' не найден"
    exit 1
fi
echo "🔍 Извлекаю уникальные IP-адреса..."
grep -oE '@[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+[:/]' "$INPUT_FILE" | \
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | \
    sort -u > /tmp/ips_$$
TOTAL=$(wc -l < /tmp/ips_$$ | tr -d ' ')
echo "✅ Найдено уникальных IP: $TOTAL"
echo ""
# ===== ЭТАП 1: ПИНГ =====
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📡 ЭТАП 1: Пинг IP-адресов"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "IP-АДРЕС;СТАТУС;ВРЕМЯ" > "$PING_RESULT"
ONLINE=0
OFFLINE=0
count=0
while read -r ip; do
    count=$((count + 1))
    printf "\r   ⏳ [%3d/%3d] %s" "$count" "$TOTAL" "$ip"
    
    result=$(ping -c 1 -W 2 "$ip" 2>&1)
    
    if echo "$result" | grep -q "time="; then
        time_ms=$(echo "$result" | grep -oE 'time=[0-9.]+' | cut -d= -f2)
        printf "\r   \033[32m✓\033[0m [%3d/%3d] %s - %sms\n" "$count" "$TOTAL" "$ip" "$time_ms"
        echo "$ip;ONLINE;${time_ms}ms" >> "$PING_RESULT"
        ONLINE=$((ONLINE + 1))
    else
        printf "\r   \033[31m✗\033[0m [%3d/%3d] %s - Timeout\n" "$count" "$TOTAL" "$ip"
        echo "$ip;OFFLINE;-" >> "$PING_RESULT"
        OFFLINE=$((OFFLINE + 1))
    fi
done < /tmp/ips_$$
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📊 Итоги пинга: \033[32m$ONLINE онлайн\033[0m / \033[31m$OFFLINE оффлайн\033[0m"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
# ===== ПАУЗА 20 СЕКУНД =====
echo ""
echo "⏳ Пауза 20 секунд перед whois..."
sleep 20
# ===== ЭТАП 2: WHOIS =====
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🌍 ЭТАП 2: Определение владельцев (whois)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "SUBNET;ORG;NETNAME;COUNTRY;ASN;PING_STATUS;PING_TIME" > "$OUTPUT_FILE"
# Берём только рабочие IP из пинга
grep "ONLINE" "$PING_RESULT" | cut -d';' -f1 > /tmp/online_ips_$$
ONLINE_TOTAL=$(wc -l < /tmp/online_ips_$$ | tr -d ' ')
echo "📡 Whois для $ONLINE_TOTAL рабочих IP..."
count=0
while read -r ip; do
    count=$((count + 1))
    printf "\r   ⏳ [%3d/%3d] %s" "$count" "$ONLINE_TOTAL" "$ip"
    
    # Получаем статус пинга
    ping_status=$(grep "^$ip;" "$PING_RESULT" | cut -d';' -f2)
    ping_time=$(grep "^$ip;" "$PING_RESULT" | cut -d';' -f3)
    
    # Whois запрос
    raw=$(timeout 4 whois -H "$ip" 2>/dev/null | tr -d '\r')
    
    if [ -z "$raw" ]; then
        printf "\r   ⚠️  [%3d/%3d] %s - No data\n" "$count" "$ONLINE_TOTAL" "$ip"
        echo "$ip/32;No Data;-;-;-;$ping_status;$ping_time" >> "$OUTPUT_FILE"
        continue
    fi
    
    # Парсинг RIPE
    org=$(echo "$raw" | grep -iE '^org-name:' | head -1 | sed 's/^org-name:[[:space:]]*//' | tr -d '\n')
    [ -z "$org" ] && org=$(echo "$raw" | grep -iE '^organisation:' | head -1 | sed 's/^organisation:[[:space:]]*//' | tr -d '\n')
